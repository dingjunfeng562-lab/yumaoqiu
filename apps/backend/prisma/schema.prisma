generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
}

enum Role {
  ROOT
  SUPER_ADMIN
  ADMIN
  REFEREE
  PLAYER
  PHOTOGRAPHER
}

enum PhotoCategory {
  PLAYER
  MATCH
  AWARD
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Gender {
  MALE
  FEMALE
}

enum EventType {
  MENS_SINGLES
  WOMENS_SINGLES
  MENS_DOUBLES
  WOMENS_DOUBLES
  MIXED_DOUBLES
}

enum Format {
  SINGLE_ELIMINATION
  GROUP_PLUS_KNOCKOUT
  GROUP_PLUS_KNOCKOUT_STD
  ROUND_ROBIN
  GROUP_PLUS_PLAYOFF
  SINGLE_ELIMINATION_PLUS_GROUP_RANKING
}

enum SecondStageStatus {
  NOT_STARTED
  DRAFT
  CONFIRMED
  FINISHED
}

enum SecondStageMode {
  MANUAL_BY_REFEREE
}

enum SecondStageRankingMode {
  TOP_6
  TOP_8
}

enum ScoringRule {
  FIFTEEN_ONE
  FIFTEEN_BO3
  TWENTYONE_BO3
  THIRTYONE_BO3
}

enum ScoringMode {
  CAPPED_30
  STANDARD_GOLDEN
}

enum TournamentStatus {
  REGISTRATION_NOT_STARTED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  FINISHED
}

enum MatchStatus {
  PENDING
  LIVE
  COMPLETED
  CANCELLED
}

enum TournamentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchEventType {
  POINT
  UNDO
  TIMEOUT
  MEDICAL_TIMEOUT
  WARNING
  YELLOW_CARD
  SERVE_CHANGE
  FORFEIT
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum DrawFormat {
  single_elim
  group_then_elim
  round_robin
  group_then_playoff
}

enum DrawStatus {
  DRAFT
  DRAWN
  FROZEN
}

enum DrawOperationType {
  SEED_UPDATE
  EXECUTE
  SWAP
  FREEZE
  REDRAW
}

enum DrawSlotSourceType {
  SEED
  NON_SEED
  BYE
  MANUAL_SWAP
}

enum DrawRedrawRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmailLogStatus {
  SENT
  FAILED
  SKIPPED
}

model InviteCode {
  id          String   @id @default(cuid())
  code        String   @unique
  role        Role
  maxUses     Int
  usedUses    Int      @default(0)
  expiresAt   DateTime?
  isEnabled   Boolean  @default(true)
  remark      String?  @db.VarChar(255)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([role])
  @@index([isEnabled])
  @@index([expiresAt])
}

model User {
  id                String             @id @default(cuid())
  username          String             @unique
  email             String             @unique
  passwordHash      String             @map("password")
  role              Role
  status            UserStatus         @default(ACTIVE)
  failedAttempts    Int                @default(0) @map("failedLoginCount")
  lockedUntil       DateTime?
  emailVerifiedAt   DateTime?
  mustChangePassword Boolean           @default(false)
  nameChangeCount       Int            @default(0)
  nameChangeWindowStart DateTime?
  inviteCodeId      String?
  inviteCode        InviteCode?        @relation(fields: [inviteCodeId], references: [id], onDelete: SetNull)
  competitionRegistrations CompetitionRegistration[]
  matches           Match[]
  drawOperationLogs DrawOperationLog[] @relation("drawOperationLogOperator")
  drawSeedSettings  DrawSeedSetting[]  @relation("drawSeedSettingCreator")
  drawRedrawRequests        DrawRedrawRequest[] @relation("drawRedrawRequestRequester")
  drawRedrawDecisions       DrawRedrawRequest[] @relation("drawRedrawRequestDecider")
  photos            Photo[]
  photoOperationLogs PhotoOperationLog[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([role])
  @@index([status])
  @@index([inviteCodeId])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String    @db.VarChar(120)
  content     String    @db.Text
  displayMode String    @default("popup") @db.VarChar(24)
  scope       String    @default("global") @db.VarChar(24)
  frequency   String    @default("every_visit") @db.VarChar(24)
  status      String    @default("draft") @db.VarChar(24)
  startAt     DateTime  @default(now())
  endAt       DateTime?
  closable    Boolean   @default(true)
  primaryButtonText String? @db.VarChar(40)
  primaryButtonLink String? @db.VarChar(255)
  secondaryButtonText String? @db.VarChar(40)
  priority    Int       @default(0)
  type        String    @default("公告") @db.VarChar(24)
  isPublished Boolean   @default(false)
  isPinned    Boolean   @default(false)
  showAsPopup Boolean   @default(false)
  sortOrder   Int       @default(0)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, isPinned, sortOrder])
  @@index([status, displayMode, scope, startAt])
  @@index([priority])
  @@index([publishedAt])
  @@index([expiresAt])
}

model Player {
  id                String         @id @default(cuid())
  name              String
  gender            Gender
  affiliation       String
  contact           String?
  notes             String?
  isTemporary       Boolean        @default(false)
  registrationsAsP1 Registration[] @relation("registrationPlayer1")
  registrationsAsP2 Registration[] @relation("registrationPlayer2")
  teamMembers       TeamMember[]
  teamLineupsAsP1   TeamLineup[]   @relation("teamLineupPlayer1")
  teamLineupsAsP2   TeamLineup[]   @relation("teamLineupPlayer2")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Tournament {
  id                    String           @id @default(cuid())
  name                  String
  edition               Int              @default(1)
  subtitle              String?
  organizer             String?
  coverImageUrl         String?
  location              String?
  projectText           String?
  formatText            String?
  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  status                TournamentStatus @default(REGISTRATION_NOT_STARTED)
  rules                 String?          @db.Text
  description           String?          @db.Text
  registrationNotice    String?          @db.Text
  maxRegistrationEvents Int              @default(2)
  allowCrossEventRegistration Boolean    @default(true)
  needsRegistrationReview Boolean        @default(true)
  defaultMatchMinutes   Int              @default(45)
  breakMinutes          Int              @default(10)
  dailyStartTime        String           @default("09:00") @db.VarChar(5)
  dailyEndTime          String           @default("18:00") @db.VarChar(5)
  isPublished           Boolean          @default(false)
  showOnHome            Boolean          @default(false)
  startDate             DateTime
  endDate               DateTime
  isArchived            Boolean          @default(false)
  approvalStatus        TournamentApprovalStatus @default(PENDING)
  submittedById         String?
  approvedById          String?
  approvedAt            DateTime?
  rejectReason          String?          @db.VarChar(500)
  events                Event[]
  competitionRegistrations CompetitionRegistration[]
  venues                Venue[]
  teamCompetitions      TeamCompetition[]
  photos                Photo[]
  watermark             TournamentWatermark?
  emailSettings         EventEmailSetting[]
  emailLogs             EmailLog[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([approvalStatus, isPublished])
}

model EmailGlobalSetting {
  id        String   @id @default("global") @db.VarChar(32)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_global_setting")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(64)
  name      String   @db.VarChar(120)
  subject   String   @db.VarChar(255)
  body      String   @db.Text
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model EventEmailSetting {
  id                  String     @id @default(cuid())
  tournamentId        String     @map("event_id")
  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  templateKey         String     @db.VarChar(64) @map("template_key")
  enabled             Boolean    @default(false)
  remindBeforeMinutes Int?       @map("remind_before_minutes")
  scheduledSendTime   DateTime?  @map("scheduled_send_time")
  autoSent            Boolean    @default(false) @map("auto_sent")
  lastSentAt          DateTime?  @map("last_sent_at")
  manualSendCount     Int        @default(0) @map("manual_send_count")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@unique([tournamentId, templateKey])
  @@index([templateKey, enabled, autoSent, scheduledSendTime])
  @@map("event_email_settings")
}

model EmailLog {
  id           String         @id @default(cuid())
  tournamentId String?        @map("event_id")
  tournament   Tournament?    @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  templateKey  String         @db.VarChar(64) @map("template_key")
  recipient    String?        @db.VarChar(191)
  subject      String?        @db.VarChar(255)
  status       EmailLogStatus
  reason       String?        @db.VarChar(500)
  trigger      String         @default("auto") @db.VarChar(16)
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([tournamentId, createdAt])
  @@index([status, createdAt])
  @@index([templateKey, status])
  @@map("email_logs")
}

model Photo {
  id              String        @id @default(cuid())
  tournamentId    String
  tournament      Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  uploaderId      String
  uploader        User          @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  category        PhotoCategory
  seq             Int           @default(0)
  originalPath    String        @db.VarChar(500)
  fullPath        String        @db.VarChar(500)
  thumbnailPath   String        @db.VarChar(500)
  fileSize        Int
  width           Int
  height          Int
  uploadedAt      DateTime      @default(now())
  deletedAt       DateTime?

  @@index([tournamentId, category, deletedAt])
  @@index([tournamentId, deletedAt, uploadedAt])
  @@index([uploaderId])
  @@index([deletedAt])
}

model TournamentWatermark {
  id                String     @id @default(cuid())
  tournamentId      String     @unique
  tournament        Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  logos             Json
  logoHeightPercent Int       @default(8)
  logoGapPercent    Int       @default(20)
  position          String    @default("TOP_RIGHT") @db.VarChar(16)
  portraitPosition  String?   @db.VarChar(16)
  // 文字水印（可选）：text 为空表示不加文字水印。
  text              String?   @db.VarChar(100)
  textColor         String?   @db.VarChar(16)
  textSizePercent   Int?
  textPosition      String?   @db.VarChar(16)
  textPortraitPosition String?   @db.VarChar(16)
  updatedAt         DateTime  @updatedAt
}

model PhotoOperationLog {
  id                   String   @id @default(cuid())
  photoId              String?
  tournamentId         String
  operatorId           String
  operator             User     @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  operatorNameSnapshot String?  @db.VarChar(64)
  action               String   @db.VarChar(32)
  detail               Json?
  createdAt            DateTime @default(now())

  @@index([tournamentId, createdAt])
  @@index([operatorId])
}

model Event {
  id                 String             @id @default(cuid())
  tournamentId       String
  tournament         Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  type               EventType
  format             Format
  scoringRule        ScoringRule
  scoringMode        ScoringMode
  customGamePoint    Int?
  customGameCap      Int?
  customGamesToWin   Int?
  /// 分阶段计分规则覆盖：{ QF?: {...}, TOP4?: {...}, SF?: {...}, BRONZE?: {...}, F?: {...} }；BEFORE_TOP4 为旧两段兼容键
  /// 每个阶段为独立完整规则：{ scoringRule? } 或 { customGamePoint, customGameCap?, customGamesToWin }
  /// 未配置的阶段使用上方默认规则
  stageScoringRules  Json?
  defaultMatchMinutes Int?
  groupSize          Int?
  groupCount         Int?
  qualifiersPerGroup Int?
  drawLocked         Boolean            @default(false)
  drawPublished      Boolean            @default(false)
  drawGeneratedAt    DateTime?
  registrations      Registration[]
  competitionRegistrationItems CompetitionRegistrationEventItem[]
  matches            Match[]
  drawBrackets       DrawBracket[]
  drawSeedSettings   DrawSeedSetting[]
  drawOperationLogs  DrawOperationLog[] @relation("drawOperationLogEvent")
  drawRedrawRequests DrawRedrawRequest[]
  secondStage        SecondStage?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model SecondStage {
  id           String                 @id @default(cuid())
  eventId      String                 @unique @map("event_id")
  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status       SecondStageStatus      @default(NOT_STARTED)
  mode         SecondStageMode        @default(MANUAL_BY_REFEREE)
  rankingMode  SecondStageRankingMode @default(TOP_8) @map("ranking_mode")
  confirmedAt  DateTime?              @map("confirmed_at")
  finishedAt   DateTime?              @map("finished_at")
  createdBy    String?                @map("created_by")
  updatedBy    String?                @map("updated_by")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  slots        SecondStageSlot[]
  matches      SecondStageMatch[]
  rankings     SecondStageRanking[]

  @@index([eventId, status])
  @@map("second_stage")
}

model SecondStageSlot {
  id                  String      @id @default(cuid())
  secondStageId       String      @map("second_stage_id")
  secondStage         SecondStage @relation(fields: [secondStageId], references: [id], onDelete: Cascade)
  slot                String      @db.VarChar(1)
  sortOrder           Int         @map("sort_order")
  entrantId           String?     @map("entrant_id")
  entrantNameSnapshot String?     @db.VarChar(128) @map("entrant_name_snapshot")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  @@unique([secondStageId, slot])
  @@index([entrantId])
  @@map("second_stage_slot")
}

model SecondStageMatch {
  id                 String      @id @default(cuid())
  secondStageId      String      @map("second_stage_id")
  secondStage        SecondStage @relation(fields: [secondStageId], references: [id], onDelete: Cascade)
  matchNo            Int         @map("match_no")
  roundName          String      @db.VarChar(32) @map("round_name")
  area               String      @db.VarChar(32)
  slotInfo           String?     @db.VarChar(32) @map("slot_info")
  side1Source        String?     @db.VarChar(32) @map("side1_source")
  side2Source        String?     @db.VarChar(32) @map("side2_source")
  side1Id            String?     @map("side1_id")
  side2Id            String?     @map("side2_id")
  side1NameSnapshot  String?     @db.VarChar(128) @map("side1_name_snapshot")
  side2NameSnapshot  String?     @db.VarChar(128) @map("side2_name_snapshot")
  score              String?     @db.VarChar(64)
  status             MatchStatus @default(PENDING)
  winnerSide         Int?        @map("winner_side")
  winnerId           String?     @map("winner_id")
  winnerNameSnapshot String?     @db.VarChar(128) @map("winner_name_snapshot")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@unique([secondStageId, matchNo])
  @@index([secondStageId, status])
  @@index([side1Id])
  @@index([side2Id])
  @@index([winnerId])
  @@map("second_stage_match")
}

model SecondStageRanking {
  id                  String      @id @default(cuid())
  secondStageId       String      @map("second_stage_id")
  secondStage         SecondStage @relation(fields: [secondStageId], references: [id], onDelete: Cascade)
  rank                Int
  entrantId           String?     @map("entrant_id")
  entrantNameSnapshot String?     @db.VarChar(128) @map("entrant_name_snapshot")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  @@unique([secondStageId, rank])
  @@index([entrantId])
  @@map("second_stage_ranking")
}

model Registration {
  id               String             @id @default(cuid())
  eventId          String
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  competitionRegistrationId String?
  competitionRegistration CompetitionRegistration? @relation(fields: [competitionRegistrationId], references: [id], onDelete: SetNull)
  player1Id        String
  player1          Player             @relation("registrationPlayer1", fields: [player1Id], references: [id])
  player2Id        String?
  player2          Player?            @relation("registrationPlayer2", fields: [player2Id], references: [id])
  name             String?
  teamName         String?            @db.VarChar(120)
  studentId        String?
  className        String?
  phone            String?
  gender           Gender?
  eventName        String?
  partnerStudentId String?
  partnerSchool    String?            @db.VarChar(191)
  partnerClassName String?            @db.VarChar(120)
  partnerPhone     String?
  remark           String?            @db.Text
  status           RegistrationStatus @default(APPROVED)
  reviewedAt       DateTime?
  reviewedBy       String?
  rejectReason     String?
  isSeed           Boolean            @default(false)
  seedRank         Int?
  groupName        String?
  drawSlots        DrawSlot[]
  drawSeedSettings DrawSeedSetting[]
  drawGroupMembers DrawGroupMember[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([eventId, player1Id, player2Id])
  @@index([competitionRegistrationId])
  @@index([eventId])
  @@index([eventId, studentId])
  @@index([eventId, status])
  @@index([status])
}

model CompetitionRegistration {
  id             String             @id @default(cuid())
  competitionId  String
  competition    Tournament         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId      String
  name           String
  gender         Gender
  school         String?            @db.VarChar(191)
  className      String?            @db.VarChar(120)
  contact        String?
  remark         String?            @db.Text
  status         RegistrationStatus @default(PENDING)
  rejectReason   String?
  reviewedAt     DateTime?
  reviewedById   String?
  eventItems     CompetitionRegistrationEventItem[]
  registrations  Registration[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([competitionId, userId])
  @@index([competitionId, status])
  @@index([userId])
  @@index([studentId])
}

model CompetitionRegistrationEventItem {
  id                         String                  @id @default(cuid())
  competitionRegistrationId  String
  competitionRegistration    CompetitionRegistration @relation(fields: [competitionRegistrationId], references: [id], onDelete: Cascade)
  eventId                    String
  event                      Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
    partnerName                String?
    partnerGender              Gender?
    partnerStudentId           String?
    partnerSchool              String?                 @db.VarChar(191)
    partnerClassName           String?                 @db.VarChar(120)
    partnerContact             String?
    teamName                   String?                 @db.VarChar(120)
  createdAt                  DateTime                @default(now())

  @@unique([competitionRegistrationId, eventId])
  @@index([eventId])
}

model TeamCompetition {
  id           String                @id @default(cuid())
  tournamentId String
  tournament   Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  description  String?               @db.Text
  winThreshold Int                   @default(3)
  isPublished  Boolean               @default(false)
  items        TeamCompetitionItem[]
  teams        Team[]
  teamMatches  TeamMatch[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([tournamentId])
}

model TeamCompetitionItem {
  id                String          @id @default(cuid())
  teamCompetitionId String
  teamCompetition   TeamCompetition @relation(fields: [teamCompetitionId], references: [id], onDelete: Cascade)
  eventType         EventType
  sortOrder         Int
  matches           Match[]
  lineups           TeamLineup[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([teamCompetitionId, eventType])
  @@unique([teamCompetitionId, sortOrder])
  @@index([teamCompetitionId, sortOrder])
}

model Team {
  id                String       @id @default(cuid())
  teamCompetitionId String
  teamCompetition   TeamCompetition @relation(fields: [teamCompetitionId], references: [id], onDelete: Cascade)
  name              String
  affiliation       String
  notes             String?
  members           TeamMember[]
  lineups           TeamLineup[]
  team1Matches      TeamMatch[]  @relation("team1Matches")
  team2Matches      TeamMatch[]  @relation("team2Matches")
  wonMatches        TeamMatch[]  @relation("winnerTeamMatches")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([teamCompetitionId, name])
  @@index([teamCompetitionId, affiliation])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId     String
  team       Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([teamId, playerId])
  @@index([playerId])
}

model TeamMatch {
  id                String          @id @default(cuid())
  teamCompetitionId String
  teamCompetition   TeamCompetition @relation(fields: [teamCompetitionId], references: [id], onDelete: Cascade)
  round             String
  roundNo           Int
  matchNo           Int
  team1Id           String?
  team1             Team?           @relation("team1Matches", fields: [team1Id], references: [id])
  team2Id           String?
  team2             Team?           @relation("team2Matches", fields: [team2Id], references: [id])
  status            MatchStatus     @default(PENDING)
  winnerTeamId      String?
  winnerTeam        Team?           @relation("winnerTeamMatches", fields: [winnerTeamId], references: [id])
  team1Wins         Int             @default(0)
  team2Wins         Int             @default(0)
  lineupLocked      Boolean         @default(false)
  matches           Match[]
  lineups           TeamLineup[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([teamCompetitionId, roundNo, matchNo])
  @@index([teamCompetitionId, status])
  @@index([winnerTeamId])
}

model TeamLineup {
  id                    String              @id @default(cuid())
  teamMatchId           String
  teamMatch             TeamMatch           @relation(fields: [teamMatchId], references: [id], onDelete: Cascade)
  teamCompetitionItemId String
  teamCompetitionItem   TeamCompetitionItem @relation(fields: [teamCompetitionItemId], references: [id], onDelete: Cascade)
  teamId                String
  team                  Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player1Id             String
  player1               Player              @relation("teamLineupPlayer1", fields: [player1Id], references: [id])
  player2Id             String?
  player2               Player?             @relation("teamLineupPlayer2", fields: [player2Id], references: [id])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([teamMatchId, teamCompetitionItemId, teamId])
  @@index([teamMatchId, teamId])
  @@index([player1Id])
  @@index([player2Id])
}

model Match {
  id                    String               @id @default(cuid())
  eventId               String?
  event                 Event?               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamMatchId           String?
  teamMatch             TeamMatch?           @relation(fields: [teamMatchId], references: [id], onDelete: Cascade)
  teamCompetitionItemId String?
  teamCompetitionItem   TeamCompetitionItem? @relation(fields: [teamCompetitionItemId], references: [id], onDelete: Cascade)
  round                 String
  roundNo               Int
  matchNo               Int
  side1Id               String?
  side2Id               String?
  refereeId             String?
  referee               User?                @relation(fields: [refereeId], references: [id])
  venueId               String?
  venue                 Venue?               @relation(fields: [venueId], references: [id])
  scheduledAt           DateTime?
  durationMinutes       Int                  @default(45)
  status                MatchStatus          @default(PENDING)
  startedAt             DateTime?
  finishedAt            DateTime?
  winnerSide            Int?
  forfeitedSide         Int?
  forfeitReason         String?              @db.VarChar(191)
  games                 Game[]
  events                MatchEvent[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([eventId, roundNo, matchNo])
  @@index([teamMatchId, teamCompetitionItemId])
  @@index([refereeId])
  @@index([venueId, scheduledAt])
  @@index([scheduledAt])
}

model Venue {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  matches      Match[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tournamentId, name])
  @@index([tournamentId, isActive, sortOrder])
}

model Game {
  id          String    @id @default(cuid())
  matchId     String
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameNo      Int
  side1Score  Int       @default(0)
  side2Score  Int       @default(0)
  server      Int?
  winnerSide  Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([matchId, gameNo])
  @@index([matchId])
}

model MatchEvent {
  id         String         @id @default(cuid())
  matchId    String
  match      Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type       MatchEventType
  side       Int?
  gameNo     Int?
  side1Score Int?
  side2Score Int?
  note       String?
  undoneAt   DateTime?
  createdAt  DateTime       @default(now())

  @@index([matchId, createdAt])
  @@index([type])
}

model DrawBracket {
  id              String             @id @default(cuid())
  eventItemId     String             @map("event_item_id")
  event           Event              @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  version         Int
  isCurrent       Boolean            @default(true) @map("is_current")
  format          DrawFormat
  status          DrawStatus         @default(DRAFT)
  bracketSize     Int                @map("bracket_size")
  entrantCount    Int                @map("entrant_count")
  seedLimit       Int                @map("seed_limit")
  seedCount       Int                @map("seed_count")
  byeCount        Int                @map("bye_count")
  groupCount      Int?               @map("group_count")
  qualifyPerGroup Int?               @map("qualify_per_group")
  executedAt      DateTime?          @map("executed_at")
  frozenAt        DateTime?          @map("frozen_at")
  createdBy       String             @map("created_by")
  updatedBy       String?            @map("updated_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  slots           DrawSlot[]
  operationLogs   DrawOperationLog[]
  groups          DrawGroup[]

  @@unique([eventItemId, version])
  @@index([eventItemId])
  @@index([eventItemId, isCurrent])
  @@index([status])
  @@map("draw_bracket")
}

model DrawSlot {
  id                  String             @id @default(cuid())
  drawBracketId       String             @map("draw_bracket_id")
  drawBracket         DrawBracket        @relation(fields: [drawBracketId], references: [id], onDelete: Cascade)
  position            Int
  entrantId           String?            @map("entrant_id")
  entrant             Registration?      @relation(fields: [entrantId], references: [id], onDelete: SetNull)
  entrantNameSnapshot String?            @db.VarChar(128) @map("entrant_name_snapshot")
  seedNoSnapshot      Int?               @map("seed_no_snapshot")
  isSeed              Boolean            @default(false) @map("is_seed")
  isBye               Boolean            @default(false) @map("is_bye")
  sourceType          DrawSlotSourceType @map("source_type")
  groupRankCode       String?            @db.VarChar(16) @map("group_rank_code")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@unique([drawBracketId, position])
  @@index([drawBracketId])
  @@index([entrantId])
  @@map("draw_slot")
}

model DrawOperationLog {
  id                   String            @id @default(cuid())
  eventItemId          String            @map("event_item_id")
  event                Event             @relation("drawOperationLogEvent", fields: [eventItemId], references: [id], onDelete: Cascade)
  drawBracketId        String            @map("draw_bracket_id")
  drawBracket          DrawBracket       @relation(fields: [drawBracketId], references: [id], onDelete: Cascade)
  operationType        DrawOperationType @map("operation_type")
  operatorId           String            @map("operator_id")
  operator             User              @relation("drawOperationLogOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  operatorNameSnapshot String?           @db.VarChar(64) @map("operator_name_snapshot")
  positionA            Int?              @map("position_a")
  positionB            Int?              @map("position_b")
  beforeData           Json?             @map("before_data")
  afterData            Json?             @map("after_data")
  remark               String?           @db.VarChar(255)
  createdAt            DateTime          @default(now()) @map("created_at")

  @@index([eventItemId, createdAt])
  @@index([drawBracketId, createdAt])
  @@index([operatorId])
  @@index([operationType])
  @@map("draw_operation_log")
}

model DrawSeedSetting {
  id          String       @id @default(cuid())
  eventItemId String       @map("event_item_id")
  event       Event        @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  entrantId   String       @map("entrant_id")
  entrant     Registration @relation(fields: [entrantId], references: [id], onDelete: Cascade)
  seedNo      Int          @map("seed_no")
  createdBy   String       @map("created_by")
  creator     User         @relation("drawSeedSettingCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@unique([eventItemId, seedNo])
  @@unique([eventItemId, entrantId])
  @@index([eventItemId])
  @@map("draw_seed_setting")
}

model DrawGroup {
  id            String            @id @default(cuid())
  drawBracketId String            @map("draw_bracket_id")
  drawBracket   DrawBracket       @relation(fields: [drawBracketId], references: [id], onDelete: Cascade)
  groupCode     String            @db.VarChar(8) @map("group_code")
  sortOrder     Int               @map("sort_order")
  createdAt     DateTime          @default(now()) @map("created_at")
  members       DrawGroupMember[]

  @@unique([drawBracketId, groupCode])
  @@index([drawBracketId])
  @@map("draw_group")
}

model DrawRedrawRequest {
  id              String                  @id @default(cuid())
  eventItemId     String                  @map("event_item_id")
  event           Event                   @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  drawBracketId   String?                 @map("draw_bracket_id")
  status          DrawRedrawRequestStatus @default(PENDING)
  reason          String?                 @db.VarChar(500)
  requesterId     String                  @map("requester_id")
  requester       User                    @relation("drawRedrawRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  requesterNameSnapshot String?           @db.VarChar(64) @map("requester_name_snapshot")
  decidedById     String?                 @map("decided_by_id")
  decidedBy       User?                   @relation("drawRedrawRequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedByNameSnapshot String?           @db.VarChar(64) @map("decided_by_name_snapshot")
  decisionRemark  String?                 @db.VarChar(500) @map("decision_remark")
  decidedAt       DateTime?               @map("decided_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@index([eventItemId, status])
  @@index([requesterId])
  @@index([status, createdAt])
  @@map("draw_redraw_request")
}

model DrawGroupMember {
  id                  String       @id @default(cuid())
  drawGroupId         String       @map("draw_group_id")
  drawGroup           DrawGroup    @relation(fields: [drawGroupId], references: [id], onDelete: Cascade)
  entrantId           String       @map("entrant_id")
  entrant             Registration @relation(fields: [entrantId], references: [id], onDelete: Cascade)
  entrantNameSnapshot String?      @db.VarChar(128) @map("entrant_name_snapshot")
  seedNoSnapshot      Int?         @map("seed_no_snapshot")
  groupRank           Int?         @map("group_rank")
  isQualified         Boolean      @default(false) @map("is_qualified")
  createdAt           DateTime     @default(now()) @map("created_at")

  @@unique([drawGroupId, entrantId])
  @@index([drawGroupId])
  @@index([entrantId])
  @@map("draw_group_member")
}
