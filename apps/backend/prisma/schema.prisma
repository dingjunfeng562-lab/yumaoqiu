generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
}

enum Role {
  ROOT
  ADMIN
  REFEREE
  PLAYER
  PHOTOGRAPHER
}

enum PhotoCategory {
  PLAYER
  MATCH
  AWARD
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Gender {
  MALE
  FEMALE
}

enum EventType {
  MENS_SINGLES
  WOMENS_SINGLES
  MENS_DOUBLES
  WOMENS_DOUBLES
  MIXED_DOUBLES
}

// 单项场地规则：INHERIT 沿用组别配置（默认，旧赛事行为不变）；ALL 忽略组别限制用全部启用场地；
// SPECIFIED 只用 EventVenue 中列出的场地。
enum VenueRuleMode {
  INHERIT
  ALL
  SPECIFIED
}

// 报名身份：SCHOOL = 学生（需学号等）；SOCIAL = 第三方（非学生、免登录，填单位）。
// 默认社会组已取消，SOCIAL 只用于字段模板为「第三方」的自定义组别。
enum EntrantType {
  SCHOOL
  SOCIAL
}

enum Format {
  SINGLE_ELIMINATION
  GROUP_PLUS_KNOCKOUT
  GROUP_PLUS_KNOCKOUT_STD
  ROUND_ROBIN
  GROUP_PLUS_PLAYOFF
  SINGLE_ELIMINATION_PLUS_GROUP_RANKING
}

enum TeamCompetitionFormat {
  SINGLE_ELIMINATION      // 单淘汰赛
  ROUND_ROBIN            // 单组循环赛（所有队伍打一遍）
  GROUP_ROUND_ROBIN      // 多组循环赛
  GROUP_PLUS_KNOCKOUT    // 小组+淘汰赛
}

// 团体淘汰赛第三名的决出方式
enum TeamThirdPlaceMode {
  BY_RECORD // 不打季军赛，两名半决赛负者按成绩排第三、四名（旧数据默认）
  SHARED    // 不打季军赛，两名半决赛负者并列第三
  PLAYOFF   // 加赛季军赛
}

enum SecondStageStatus {
  NOT_STARTED
  DRAFT
  CONFIRMED
  FINISHED
}

enum SecondStageMode {
  MANUAL_BY_REFEREE
}

enum SecondStageRankingMode {
  TOP_6
  TOP_8
}

enum ScoringRule {
  FIFTEEN_ONE
  FIFTEEN_BO3
  TWENTYONE_BO3
  THIRTYONE_BO3
}

enum ScoringMode {
  CAPPED_30
  STANDARD_GOLDEN
}

enum TournamentStatus {
  REGISTRATION_NOT_STARTED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  FINISHED
}

enum MatchStatus {
  PENDING
  LIVE
  COMPLETED
  CANCELLED
}

enum TournamentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchEventType {
  POINT
  UNDO
  TIMEOUT
  MEDICAL_TIMEOUT
  WARNING
  YELLOW_CARD
  SERVE_CHANGE
  FORFEIT
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum DrawFormat {
  single_elim
  group_then_elim
  round_robin
  group_then_playoff
}

enum DrawStatus {
  DRAFT
  DRAWN
  FROZEN
}

enum DrawOperationType {
  SEED_UPDATE
  EXECUTE
  SWAP
  FREEZE
  REDRAW
}

enum DrawSlotSourceType {
  SEED
  NON_SEED
  BYE
  MANUAL_SWAP
}

enum DrawRedrawRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TeamDrawClearRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmailLogStatus {
  SENT
  FAILED
  SKIPPED
}

// 缴费状态：未缴费 / 已缴费（管理员确认转账）/ 免缴（特邀、工作人员等）。
enum PaymentStatus {
  UNPAID
  PAID
  WAIVED
}

model InviteCode {
  id           String   @id @default(cuid())
  code         String   @unique
  role         Role
  maxUses      Int
  usedUses     Int      @default(0)
  // 创建邀请码时已按 maxUses 从发放人余额预扣；历史邀请码为 false，注册成功时才扣。
  quotaCharged Boolean  @default(false)
  expiresAt    DateTime?
  isEnabled    Boolean  @default(true)
  remark       String?  @db.VarChar(255)
  users        User[]
  createdById  String?
  createdBy    User?    @relation("IssuedInvites", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([createdById])
  @@index([isEnabled])
  @@index([expiresAt])
}

model User {
  id                String             @id @default(cuid())
  username          String             @unique
  email             String             @unique
  passwordHash      String             @map("password")
  role              Role
  status            UserStatus         @default(ACTIVE)
  failedAttempts    Int                @default(0) @map("failedLoginCount")
  lockedUntil       DateTime?
  emailVerifiedAt   DateTime?
  mustChangePassword Boolean           @default(false)
  nameChangeCount       Int            @default(0)
  nameChangeWindowStart DateTime?
  inviteCodeId      String?
  inviteCode        InviteCode?        @relation(fields: [inviteCodeId], references: [id], onDelete: SetNull)
  managerId         String?
  manager           User?              @relation("ManagedUsers", fields: [managerId], references: [id], onDelete: SetNull)
  managedUsers      User[]             @relation("ManagedUsers")
  issuedInvites     InviteCode[]       @relation("IssuedInvites")
  staffInviteLimit  Int                @default(20)
  staffInviteUsed   Int                @default(0)
  permissions       Json?
  staffQuotaCharged Boolean            @default(false)
  ownedPlayers     Player[]
  competitionRegistrations CompetitionRegistration[]
  matches           Match[]
  refereeTournamentGrants RefereeTournamentGrant[]
  drawOperationLogs DrawOperationLog[] @relation("drawOperationLogOperator")
  drawSeedSettings  DrawSeedSetting[]  @relation("drawSeedSettingCreator")
  drawRedrawRequests        DrawRedrawRequest[] @relation("drawRedrawRequestRequester")
  drawRedrawDecisions       DrawRedrawRequest[] @relation("drawRedrawRequestDecider")
  teamDrawClearRequests     TeamDrawClearRequest[] @relation("teamDrawClearRequestRequester")
  teamDrawClearDecisions    TeamDrawClearRequest[] @relation("teamDrawClearRequestDecider")
  photos            Photo[]
  createdPhotoActivities PhotoActivity[] @relation("PhotoActivityCreator")
  approvedPhotoActivities PhotoActivity[] @relation("PhotoActivityApprover")
  photoOperationLogs PhotoOperationLog[]
  photoUploadGrants PhotoUploadGrant[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([role])
  @@index([status])
  @@index([inviteCodeId])
  @@index([managerId])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String    @db.VarChar(120)
  content     String    @db.Text
  displayMode String    @default("popup") @db.VarChar(24)
  scope       String    @default("global") @db.VarChar(24)
  frequency   String    @default("every_visit") @db.VarChar(24)
  status      String    @default("draft") @db.VarChar(24)
  startAt     DateTime  @default(now())
  endAt       DateTime?
  closable    Boolean   @default(true)
  primaryButtonText String? @db.VarChar(40)
  primaryButtonLink String? @db.VarChar(255)
  secondaryButtonText String? @db.VarChar(40)
  priority    Int       @default(0)
  type        String    @default("公告") @db.VarChar(24)
  isPublished Boolean   @default(false)
  isPinned    Boolean   @default(false)
  showAsPopup Boolean   @default(false)
  sortOrder   Int       @default(0)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, isPinned, sortOrder])
  @@index([status, displayMode, scope, startAt])
  @@index([priority])
  @@index([publishedAt])
  @@index([expiresAt])
}

model Player {
  id                String         @id @default(cuid())
  name              String
  gender            Gender?
  affiliation       String
  contact           String?
  notes             String?
  isTemporary       Boolean        @default(false)
  ownerId           String?
  owner             User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  registrationsAsP1 Registration[] @relation("registrationPlayer1")
  registrationsAsP2 Registration[] @relation("registrationPlayer2")
  teamMembers       TeamMember[]
  teamLineupsAsP1   TeamLineup[]   @relation("teamLineupPlayer1")
  teamLineupsAsP2   TeamLineup[]   @relation("teamLineupPlayer2")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  @@index([ownerId])
  // 公开缴费查询按姓名精确匹配。
  @@index([name])
}

model TournamentGroup {
  id String @id @default(cuid())
  tournamentId String
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name String @db.VarChar(60)
  categoryLabel String? @db.VarChar(60)
  legacyType EntrantType?
  fieldTemplate String @default("GENERAL") @db.VarChar(16)
  enabled Boolean @default(true)
  // 本组总人数上限：一人一份报名，报几个项目都算 1 人；待审核和已通过都占名额。为空表示不限。
  // 只限制扫码报名，后台添加、导入、审核通过不受限制；已报名的选手追加项目不占组别人数。
  maxEntrants Int?
  registrationCode String? @unique @db.VarChar(16)
  registrationCodeEnabled Boolean @default(true)
  fieldRules Json?
  ageRule Json?
  ruleVersion Int @default(1)
  restrictVenues Boolean @default(false)
  allowedVenues GroupVenue[]
  // 场地排程：本组只在这几天比赛，["2026-11-15", ...]（比赛地日期）。为空表示赛事期间哪天都可以。
  playDates Json?
  sortOrder Int @default(0)
  events Event[]
  teamCompetitions TeamCompetition[]
  paymentSettings TournamentPaymentSetting[]
  applications CompetitionRegistration[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tournamentId, name])
  @@unique([tournamentId, legacyType])
}

model Tournament {
  id                    String           @id @default(cuid())
  name                  String
  edition               Int              @default(1)
  subtitle              String?
  organizer             String?
  coverImageUrl         String?
  location              String?
  projectText           String?
  formatText            String?
  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  status                TournamentStatus @default(REGISTRATION_NOT_STARTED)
  rules                 String?          @db.Text
  description           String?          @db.Text
  registrationNotice    String?          @db.Text
  maxRegistrationEvents Int              @default(2)
  allowCrossEventRegistration Boolean    @default(true)
  needsRegistrationReview Boolean        @default(true)

  // 赛事报名码：一个赛事一个码，扫码后报名人自己选组别。registrationCodeEnabled 为它的启停开关。
  // 码只用于进入报名页，不是身份认证。
  registrationCode                String? @unique @db.VarChar(16)
  // 以下为默认学生组的旧报名码（与 TournamentGroup(legacyType=SCHOOL) 同步），仅为兼容已发出的旧码保留。
  allowSchoolRegistration         Boolean @default(true)
  schoolRegistrationCode          String? @unique @db.VarChar(16)
  schoolRegistrationCodeEnabled   Boolean @default(true)
  registrationCodeEnabled         Boolean @default(true)
  /// 默认学生组报名字段规则：{ SCHOOL: { studentId, college, majorGrade } }
  /// 值为 required / optional / hidden；为空时使用默认规则。
  registrationFieldRules          Json?
  /// 报名信息修改截止时间：过了这个时间，后台缴费管理和参赛选手页都不能再改报名信息和组别（删除不受影响）。为空表示不限制。
  registrationEditDeadline DateTime?
  defaultMatchMinutes   Int              @default(45)
  breakMinutes          Int              @default(10)
  dailyStartTime        String           @default("09:00") @db.VarChar(5)
  dailyEndTime          String           @default("18:00") @db.VarChar(5)
  isPublished           Boolean          @default(false)
  showOnHome            Boolean          @default(false)
  photoAccessToken      String?          @unique @db.VarChar(64)
  photoUploadToken      String?          @unique @db.VarChar(64)
  screenSettings        Json?
  schedulingSettings    Json?
  // 比赛结束签字确认：开启后裁判端结束比赛（含弃权、退赛、黑牌）必须先由胜方选手、再由裁判手写签字，
  // 并生成电子比分单（MatchScoreSheet）。在后台「裁判分配」按赛事设置，默认关闭。
  requireMatchSignature Boolean          @default(false)
  scheduleLogs          ScheduleOperationLog[]
  // 前台赛事主页被打开的次数（每次打开都算，含刷新）；赛事列表封面右下角「小眼睛」显示。
  viewCount             Int              @default(0)
  startDate             DateTime
  endDate               DateTime
  isArchived            Boolean          @default(false)
  approvalStatus        TournamentApprovalStatus @default(PENDING)
  submittedById         String?
  approvedById          String?
  approvedAt            DateTime?
  rejectReason          String?          @db.VarChar(500)
  registrationGroups    TournamentGroup[]
  events                Event[]
  competitionRegistrations CompetitionRegistration[]
  venues                Venue[]
  teamCompetitions      TeamCompetition[]
  photos                Photo[]
  watermark             TournamentWatermark?
  emailSettings         EventEmailSetting[]
  emailLogs             EmailLog[]
  refereeAccessCode     RefereeTournamentAccessCode?
  refereeGrants         RefereeTournamentGrant[]
  photoUploadGrants     PhotoUploadGrant[]
  broadcasts            BroadcastSession[]
  paymentSettings       TournamentPaymentSetting[]
  paymentLogs           PaymentLog[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([approvalStatus, isPublished])
  @@index([submittedById])
}

// 每个赛事每个组别一份收费设置。金额单位为分。
// 单打按人（一条报名）收，双打按对收，团体赛按队收。
model TournamentPaymentSetting {
  groupId String?
  group TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  entrantType  EntrantType
  enabled      Boolean     @default(false)
  singlesFee   Int         @default(0)
  doublesFee   Int         @default(0)
  teamFee      Int         @default(0)
  // 收款户名、账号、转账备注要求等说明，选手端原样展示。
  instructions String?     @db.Text
  qrImageUrl   String?     @db.VarChar(255)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([tournamentId, groupId])
}

// 缴费状态变更记录。registrationId / teamId 不建外键，报名或队伍删除后记录仍保留。
model PaymentLog {
  id             String        @id @default(cuid())
  tournamentId   String
  tournament     Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  entrantType    EntrantType
  // STATUS：缴费状态变更；DELETE：删除报名或队伍（from/to 均为删除时的状态）；GROUP_CHANGE：改组别。
  action         String        @default("STATUS") @db.VarChar(16)
  registrationId String?
  teamId         String?
  // 记录当时的参赛方名称和项目，便于对账。
  targetName     String        @db.VarChar(191)
  itemName       String        @db.VarChar(120)
  fromStatus     PaymentStatus
  toStatus       PaymentStatus
  amount         Int?
  note           String?       @db.VarChar(255)
  operatorId     String?
  operatorName   String?       @db.VarChar(191)
  createdAt      DateTime      @default(now())

  @@index([tournamentId, createdAt])
  @@index([registrationId])
  @@index([teamId])
}

enum BroadcastStatus {
  READY
  LIVE
  INTERRUPTED
  ENDED
}

// 视频直播间：一次直播可连续切换多场比赛；比分始终读取 Match/Game，不另存。
model BroadcastSession {
  id                String          @id @default(cuid())
  title             String          @db.VarChar(120)
  tournamentId      String
  tournament        Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade, map: "broadcast_session_tournament_fkey")
  venueId           String?
  venue             Venue?          @relation(fields: [venueId], references: [id], onDelete: SetNull, map: "broadcast_session_venue_fkey")
  currentMatchId    String?
  currentMatch      Match?          @relation(fields: [currentMatchId], references: [id], onDelete: SetNull, map: "broadcast_session_match_fkey")
  createdById       String?
  enabled           Boolean         @default(true)
  isPublic          Boolean         @default(false)
  status            BroadcastStatus @default(READY)
  overlayTokenHash  String          @unique @db.VarChar(64)
  overlaySettings   Json?
  configVersion     Int             @default(1)
  playbackUrl       String?         @db.VarChar(1000)
  provider          String?         @db.VarChar(40)
  streamName        String?         @db.VarChar(120)
  // 摄像端（安卓 App）：令牌只存哈希；推流地址含密钥，AES-GCM 加密后存放。
  cameraTokenHash   String?         @unique @db.VarChar(64)
  ingestUrlEnc      String?         @db.Text
  cameraSettings    Json?
  cameraState       Json?
  cameraLastSeenAt  DateTime?
  startedAt         DateTime?
  endedAt           DateTime?
  lastStreamEventAt DateTime?
  // LiveKit 多机位控制状态；比分仍从 currentMatch 读取。
  liveRoomName      String?         @unique @db.VarChar(120)
  liveSequence      Int             @default(0)
  activeCameraId    String?
  previewCameraId   String?
  audioCameraId     String?
  previousCameraId  String?
  transitionUntil  DateTime?
  cameras           BroadcastCamera[]
  liveLogs          BroadcastLiveLog[]
  directors         BroadcastDirector[]
  joinInvite        BroadcastJoinInvite?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tournamentId])
  @@index([currentMatchId])
  @@index([venueId])
  @@map("broadcast_session")
}

model BroadcastCamera {
  id               String           @id @default(cuid())
  broadcastId      String
  broadcast        BroadcastSession @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  code             String           @db.VarChar(12)
  name             String           @db.VarChar(60)
  pairingHash      String?          @unique @db.VarChar(64)
  pairingExpiresAt DateTime?
  tokenHash        String?          @unique @db.VarChar(64)
  deviceId         String?          @db.VarChar(120)
  state            Json?
  lastSeenAt       DateTime?
  createdAt        DateTime         @default(now())
  @@unique([broadcastId, code])
  @@map("broadcast_camera")
}

model BroadcastJoinInvite {
  id          String           @id @default(cuid())
  broadcastId String           @unique
  broadcast   BroadcastSession @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  codeHash    String           @unique @db.VarChar(64)
  expiresAt   DateTime
  claims      Int              @default(0)
  @@map("broadcast_join_invite")
}

model BroadcastDirector {
  id          String           @id @default(cuid())
  broadcastId String
  broadcast   BroadcastSession @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId      String
  canAudio    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  @@unique([broadcastId, userId])
  @@map("broadcast_director")
}

model BroadcastLiveLog {
  id          String           @id @default(cuid())
  broadcastId String
  broadcast   BroadcastSession @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  kind        String           @db.VarChar(30)
  fromId      String?
  toId        String?
  operatorId  String?
  sequence    Int
  createdAt   DateTime         @default(now())
  @@index([broadcastId, createdAt])
  @@map("broadcast_live_log")
}

model RefereeTournamentAccessCode {
  tournamentId String @id
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade, map: "referee_access_code_tournament_fkey")
  token String @unique @db.VarChar(64)
  createdAt DateTime @default(now())

  @@map("referee_tournament_access_code")
}

model RefereeTournamentGrant {
  tournamentId String
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade, map: "referee_grant_tournament_fkey")
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "referee_grant_user_fkey")
  grantedAt DateTime @default(now())

  @@id([tournamentId, userId])
  @@index([userId])
  @@map("referee_tournament_grant")
}

model EmailGlobalSetting {
  id        String   @id @default("global") @db.VarChar(32)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_global_setting")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(64)
  name      String   @db.VarChar(120)
  subject   String   @db.VarChar(255)
  body      String   @db.Text
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model EventEmailSetting {
  id                  String     @id @default(cuid())
  tournamentId        String     @map("event_id")
  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  templateKey         String     @db.VarChar(64) @map("template_key")
  enabled             Boolean    @default(false)
  remindBeforeMinutes Int?       @map("remind_before_minutes")
  scheduledSendTime   DateTime?  @map("scheduled_send_time")
  autoSent            Boolean    @default(false) @map("auto_sent")
  lastSentAt          DateTime?  @map("last_sent_at")
  manualSendCount     Int        @default(0) @map("manual_send_count")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@unique([tournamentId, templateKey])
  @@index([templateKey, enabled, autoSent, scheduledSendTime])
  @@map("event_email_settings")
}

model EmailLog {
  id           String         @id @default(cuid())
  tournamentId String?        @map("event_id")
  tournament   Tournament?    @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  templateKey  String         @db.VarChar(64) @map("template_key")
  recipient    String?        @db.VarChar(191)
  subject      String?        @db.VarChar(255)
  status       EmailLogStatus
  reason       String?        @db.VarChar(500)
  trigger      String         @default("auto") @db.VarChar(16)
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([tournamentId, createdAt])
  @@index([status, createdAt])
  @@index([templateKey, status])
  @@map("email_logs")
}

model Photo {
  id              String        @id @default(cuid())
  tournamentId    String?
  tournament      Tournament?   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  activityId      String?
  activity        PhotoActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  uploaderId      String
  uploader        User          @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  category        PhotoCategory
  seq             Int           @default(0)
  originalPath    String        @db.VarChar(500)
  fullPath        String        @db.VarChar(500)
  thumbnailPath   String        @db.VarChar(500)
  fileSize        Int
  width           Int
  height          Int
  viewCount       Int           @default(0)
  downloadCount   Int           @default(0)
  uploadedAt      DateTime      @default(now())
  deletedAt       DateTime?

  @@index([tournamentId, category, deletedAt])
  @@index([tournamentId, deletedAt, uploadedAt])
  @@index([activityId, category, deletedAt])
  @@index([activityId, deletedAt, uploadedAt])
  @@index([uploaderId])
  @@index([deletedAt])
}

