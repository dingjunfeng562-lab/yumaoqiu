model Event {
  groupId String?
  group TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  id                 String             @id @default(cuid())
  tournamentId       String
  tournament         Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  type               EventType
  // 不同组别可同时存在同类型 Event，按 groupId 区分。
  entrantType        EntrantType        @default(SCHOOL)
  // 展示用组名，等于所属组别名；旧赛事为 null，显示原项目名。
  groupLabel         String?            @db.VarChar(60)
  format             Format
  rankingLimit       Int?
  scoringRule        ScoringRule
  scoringMode        ScoringMode
  customGamePoint    Int?
  customGameCap      Int?
  customGamesToWin   Int?
  /// 分阶段计分规则覆盖：{ QF?: {...}, TOP4?: {...}, SF?: {...}, BRONZE?: {...}, F?: {...} }；BEFORE_TOP4 为旧两段兼容键
  /// 每个阶段为独立完整规则：{ scoringRule? } 或 { customGamePoint, customGameCap?, customGamesToWin }
  /// 未配置的阶段使用上方默认规则
  stageScoringRules  Json?
  defaultMatchMinutes Int?
  groupSize          Int?
  groupCount         Int?
  qualifiersPerGroup Int?
  drawLocked         Boolean            @default(false)
  // 单项场地规则，优先于所属组别；INHERIT 时沿用组别「组别场地分配」。
  venueRule          VenueRuleMode      @default(INHERIT)
  allowedVenues      EventVenue[]
  drawPublished      Boolean            @default(false)
  drawGeneratedAt    DateTime?
  /// 签表生成后报名有删除、调出或调入：签表与参赛名单不一致，需要重新抽签；重新抽签或清空签表后复位。为 true 时不能冻结或发布。
  drawStale          Boolean            @default(false)
  /// 报名名额：单打按人、双打按队（一对算一个），待审核和已通过都占名额；为空表示不限。
  /// 只限制扫码报名，后台添加、导入、审核通过不受限制。
  maxEntries         Int?
  registrations      Registration[]
  competitionRegistrationItems CompetitionRegistrationEventItem[]
  matches            Match[]
  drawBrackets       DrawBracket[]
  drawSeedSettings   DrawSeedSetting[]
  drawOperationLogs  DrawOperationLog[] @relation("drawOperationLogEvent")
  drawRedrawRequests DrawRedrawRequest[]
  secondStage        SecondStage?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([tournamentId, groupId, type])
  @@index([tournamentId, entrantType])
}

model SecondStage {
  id           String                 @id @default(cuid())
  eventId      String                 @unique @map("event_id")
  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status       SecondStageStatus      @default(NOT_STARTED)
  mode         SecondStageMode        @default(MANUAL_BY_REFEREE)
  rankingMode  SecondStageRankingMode @default(TOP_8) @map("ranking_mode")
  confirmedAt  DateTime?              @map("confirmed_at")
  finishedAt   DateTime?              @map("finished_at")
  createdBy    String?                @map("created_by")
  updatedBy    String?                @map("updated_by")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  slots        SecondStageSlot[]
  matches      SecondStageMatch[]
  rankings     SecondStageRanking[]

  @@index([eventId, status])
  @@map("second_stage")
}

model SecondStageSlot {
  id                  String      @id @default(cuid())
  secondStageId       String      @map("second_stage_id")
  secondStage         SecondStage @relation(fields: [secondStageId], references: [id], onDelete: Cascade)
  slot                String      @db.VarChar(1)
  sortOrder           Int         @map("sort_order")
  entrantId           String?     @map("entrant_id")
  entrantNameSnapshot String?     @db.VarChar(128) @map("entrant_name_snapshot")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  @@unique([secondStageId, slot])
  @@index([entrantId])
  @@map("second_stage_slot")
}

model SecondStageMatch {
  id                 String      @id @default(cuid())
  secondStageId      String      @map("second_stage_id")
  secondStage        SecondStage @relation(fields: [secondStageId], references: [id], onDelete: Cascade)
  matchNo            Int         @map("match_no")
  roundName          String      @db.VarChar(32) @map("round_name")
  area               String      @db.VarChar(32)
  slotInfo           String?     @db.VarChar(32) @map("slot_info")
  side1Source        String?     @db.VarChar(32) @map("side1_source")
  side2Source        String?     @db.VarChar(32) @map("side2_source")
  side1Id            String?     @map("side1_id")
  side2Id            String?     @map("side2_id")
  side1NameSnapshot  String?     @db.VarChar(128) @map("side1_name_snapshot")
  side2NameSnapshot  String?     @db.VarChar(128) @map("side2_name_snapshot")
  score              String?     @db.VarChar(64)
  status             MatchStatus @default(PENDING)
  winnerSide         Int?        @map("winner_side")
  winnerId           String?     @map("winner_id")
  winnerNameSnapshot String?     @db.VarChar(128) @map("winner_name_snapshot")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@unique([secondStageId, matchNo])
  @@index([secondStageId, status])
  @@index([side1Id])
  @@index([side2Id])
  @@index([winnerId])
  @@map("second_stage_match")
}

model SecondStageRanking {
  id                  String      @id @default(cuid())
  secondStageId       String      @map("second_stage_id")
  secondStage         SecondStage @relation(fields: [secondStageId], references: [id], onDelete: Cascade)
  rank                Int
  entrantId           String?     @map("entrant_id")
  entrantNameSnapshot String?     @db.VarChar(128) @map("entrant_name_snapshot")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  @@unique([secondStageId, rank])
  @@index([entrantId])
  @@map("second_stage_ranking")
}

model Registration {
  id               String             @id @default(cuid())
  eventId          String
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  competitionRegistrationId String?
  competitionRegistration CompetitionRegistration? @relation(fields: [competitionRegistrationId], references: [id], onDelete: SetNull)
  player1Id        String
  player1          Player             @relation("registrationPlayer1", fields: [player1Id], references: [id])
  player2Id        String?
  player2          Player?            @relation("registrationPlayer2", fields: [player2Id], references: [id])
  name             String?
  teamName         String?            @db.VarChar(120)
  entrantType      EntrantType        @default(SCHOOL)
  studentId        String?
  college          String?            @db.VarChar(120)
  majorGrade       String?            @db.VarChar(120)
  className        String?
  phone            String?
  gender           Gender?
  eventName        String?
  partnerStudentId String?
  partnerSchool    String?            @db.VarChar(191)
  partnerCollege   String?            @db.VarChar(120)
  partnerMajorGrade String?           @db.VarChar(120)
  partnerClassName String?            @db.VarChar(120)
  partnerPhone     String?
  remark           String?            @db.Text
  status           RegistrationStatus @default(APPROVED)
  reviewedAt       DateTime?
  reviewedBy       String?
  rejectReason     String?
  isSeed           Boolean            @default(false)
  seedRank         Int?
  finalRank        Int?
  groupName        String?
  // 缴费：双打一条报名即一对，按对收一次。paidAmount 为确认时的实缴金额（分）。
  paymentStatus    PaymentStatus      @default(UNPAID)
  paidAmount       Int?
  paidAt           DateTime?
  paymentConfirmedById String?
  paymentNote      String?            @db.VarChar(255)
  drawSlots        DrawSlot[]
  drawSeedSettings DrawSeedSetting[]
  drawGroupMembers DrawGroupMember[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([eventId, player1Id, player2Id])
  @@index([competitionRegistrationId])
  @@index([eventId])
  @@index([eventId, studentId])
  @@index([eventId, status])
  @@index([status])
  identityData Json?
  partnerIdentityData Json?
  eligibility Json?
}

model CompetitionRegistration {
  groupId String?
  group TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  id             String             @id @default(cuid())
  competitionId  String
  competition    Tournament         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  // 游客报名时 userId 为空，用 guestToken 查询。
  userId         String?
  user           User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entrantType    EntrantType        @default(SCHOOL)
  // 第三方没有学号；学生组是否必填由组别字段规则决定。
  studentId      String?
  college        String?            @db.VarChar(120)
  majorGrade     String?            @db.VarChar(120)
  guestToken     String?            @unique @db.VarChar(64)
  guestEmail     String?            @db.VarChar(191)
  name           String
  gender         Gender?
  school         String?            @db.VarChar(191)
  className      String?            @db.VarChar(120)
  contact        String?
  // 年龄：填了身份证号时按身份证和组别年龄口径计算，否则为报名人自填；衣服尺寸由报名人手填。
  age            Int?
  shirtSize      String?            @db.VarChar(32)
  remark         String?            @db.Text
  status         RegistrationStatus @default(PENDING)
  rejectReason   String?
  reviewedAt     DateTime?
  reviewedById   String?
  eventItems     CompetitionRegistrationEventItem[]
  registrations  Registration[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([competitionId, userId])
  @@unique([competitionId, personKey])
  @@index([competitionId, status])
  @@index([competitionId, entrantType, status])
  @@index([userId])
  @@index([studentId])
  personKey String? @db.VarChar(64)
  identityData Json?
  eligibility Json?
}

model CompetitionRegistrationEventItem {
  id                         String                  @id @default(cuid())
  competitionRegistrationId  String
  competitionRegistration    CompetitionRegistration @relation(fields: [competitionRegistrationId], references: [id], onDelete: Cascade)
  eventId                    String
  event                      Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
    partnerName                String?
    partnerGender              Gender?
    partnerStudentId           String?
    partnerSchool              String?                 @db.VarChar(191)
    partnerCollege             String?                 @db.VarChar(120)
    partnerMajorGrade          String?                 @db.VarChar(120)
    partnerClassName           String?                 @db.VarChar(120)
    partnerContact             String?
    partnerAge                 Int?
    partnerShirtSize           String?                 @db.VarChar(32)
    teamName                   String?                 @db.VarChar(120)
  createdAt                  DateTime                @default(now())

  @@unique([competitionRegistrationId, eventId])
  @@index([eventId])
  identityData Json?
  partnerIdentityData Json?
  eligibility Json?
}

model TeamCompetition {
  groupId String?
  group TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  id           String                @id @default(cuid())
  tournamentId String
  tournament   Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  // 每个组别最多一条团体赛；旧数据默认学生组。
  entrantType  EntrantType           @default(SCHOOL)
  name         String
  description  String?               @db.Text
  winThreshold Int                   @default(3)
  malePlayerCount Int?
  femalePlayerCount Int?
  // 0：不限制；1：不能兼项；2：同一场比赛最多参加两个单项。
  maxPlayerAppearances Int @default(2)
  playAllMatches Boolean @default(false)
  scoringRule ScoringRule @default(TWENTYONE_BO3)
  scoringMode ScoringMode @default(CAPPED_30)
  customGamePoint Int?
  customGameCap Int?
  customGamesToWin Int?
  rankingLimit Int?
  thirdPlaceMode TeamThirdPlaceMode @default(BY_RECORD)
  isPublished  Boolean               @default(false)
  
  // 新增：赛制类型
  format TeamCompetitionFormat @default(SINGLE_ELIMINATION)
  
  // 新增：小组赛配置
  groupCount Int? // 分组数量，null表示单组或不分组
  teamsPerGroup Int? // 每组队伍数（可选，自动计算）
  advancePerGroup Int? // 每组晋级数（用于小组+淘汰）
  
  items        TeamCompetitionItem[]
  teams        Team[]
  teamMatches  TeamMatch[]
  groups       TeamGroup[]
  drawClearRequests TeamDrawClearRequest[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([tournamentId, groupId])
  @@index([tournamentId])
}

model TeamCompetitionItem {
  id                String          @id @default(cuid())
  teamCompetitionId String
  teamCompetition   TeamCompetition @relation(fields: [teamCompetitionId], references: [id], onDelete: Cascade)
  eventType         EventType
  sortOrder         Int
  matches           Match[]
  lineups           TeamLineup[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // 同一项目可以重复出场（如三单两双），按出场顺序区分，所以不再对 eventType 设唯一约束。
  @@unique([teamCompetitionId, sortOrder])
  @@index([teamCompetitionId, sortOrder])
}

model Team {
  id                String       @id @default(cuid())
  teamCompetitionId String
  teamCompetition   TeamCompetition @relation(fields: [teamCompetitionId], references: [id], onDelete: Cascade)
  name              String
  affiliation       String
  notes             String?
  finalRank         Int?
  rosterOverrideConfirmed Boolean @default(false)
  // 团体赛按队收费。
  paymentStatus     PaymentStatus @default(UNPAID)
  paidAmount        Int?
  paidAt            DateTime?
  paymentConfirmedById String?
  paymentNote       String?      @db.VarChar(255)
  members           TeamMember[]
  lineups           TeamLineup[]
  team1Matches      TeamMatch[]  @relation("team1Matches")
  team2Matches      TeamMatch[]  @relation("team2Matches")
  wonMatches        TeamMatch[]  @relation("winnerTeamMatches")
  groupMemberships  TeamGroupMember[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([teamCompetitionId, name])
  @@index([teamCompetitionId, affiliation])
}

model TeamMember {
  identityData Json?
  eligibility Json?
  id        String   @id @default(cuid())
  teamId     String
  team       Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([teamId, playerId])
  @@index([playerId])
}

model TeamMatch {
  id                String          @id @default(cuid())
  teamCompetitionId String
  teamCompetition   TeamCompetition @relation(fields: [teamCompetitionId], references: [id], onDelete: Cascade)
  round             String
  roundNo           Int
  matchNo           Int
  team1Id           String?
  team1             Team?           @relation("team1Matches", fields: [team1Id], references: [id])
  team2Id           String?
  team2             Team?           @relation("team2Matches", fields: [team2Id], references: [id])
  status            MatchStatus     @default(PENDING)
  winnerTeamId      String?
  winnerTeam        Team?           @relation("winnerTeamMatches", fields: [winnerTeamId], references: [id])
  team1Wins         Int             @default(0)
  team2Wins         Int             @default(0)
  lineupLocked      Boolean         @default(false)
  
  // 新增：小组赛关联
  groupId           String?
  group             TeamGroup?      @relation("groupMatches", fields: [groupId], references: [id])
  stage             String?         // "GROUP", "KNOCKOUT", "FINAL"
  
  matches           Match[]
  lineups           TeamLineup[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([teamCompetitionId, roundNo, matchNo])
  @@index([teamCompetitionId, status])
  @@index([winnerTeamId])
  @@index([groupId])
}

// 新增：小组表
model TeamGroup {
  id                String            @id @default(cuid())
  teamCompetitionId String
  teamCompetition   TeamCompetition   @relation(fields: [teamCompetitionId], references: [id], onDelete: Cascade)
  groupNo           Int               // 组号：1, 2, 3...
  groupName         String            // 组名：A组, B组...
  teams             TeamGroupMember[]
  matches           TeamMatch[]       @relation("groupMatches")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@unique([teamCompetitionId, groupNo])
  @@index([teamCompetitionId])
}

// 新增：小组队伍关联表
model TeamGroupMember {
  id          String    @id @default(cuid())
  groupId     String
  group       TeamGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seedOrder   Int?      // 种子位顺序
  
  // 小组赛积分统计（自动计算）
  wins        Int       @default(0) // 胜场数（团体赛维度）
  losses      Int       @default(0) // 负场数（团体赛维度）
  matchesWon  Int       @default(0) // 赢的子项数
  matchesLost Int       @default(0) // 输的子项数
  netMatches  Int       @default(0) // 净胜分（子项维度）
  groupRank   Int?      // 小组排名
  advanced    Boolean   @default(false) // 是否晋级
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([groupId, teamId])
  @@index([teamId])
  @@index([groupId, groupRank])
}

model TeamLineup {
  id                    String              @id @default(cuid())
  teamMatchId           String
  teamMatch             TeamMatch           @relation(fields: [teamMatchId], references: [id], onDelete: Cascade)
  teamCompetitionItemId String
  teamCompetitionItem   TeamCompetitionItem @relation(fields: [teamCompetitionItemId], references: [id], onDelete: Cascade)
  teamId                String
  team                  Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player1Id             String
  player1               Player              @relation("teamLineupPlayer1", fields: [player1Id], references: [id])
  player2Id             String?
  player2               Player?             @relation("teamLineupPlayer2", fields: [player2Id], references: [id])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([teamMatchId, teamCompetitionItemId, teamId])
  @@index([teamMatchId, teamId])
  @@index([player1Id])
  @@index([player2Id])
}

model Match {
  id                    String               @id @default(cuid())
  eventId               String?
  event                 Event?               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamMatchId           String?
  teamMatch             TeamMatch?           @relation(fields: [teamMatchId], references: [id], onDelete: Cascade)
  teamCompetitionItemId String?
  teamCompetitionItem   TeamCompetitionItem? @relation(fields: [teamCompetitionItemId], references: [id], onDelete: Cascade)
  round                 String
  roundNo               Int
  matchNo               Int
  side1Id               String?
  side2Id               String?
  refereeId             String?
  referee               User?                @relation(fields: [refereeId], references: [id])
  venueId               String?
  venue                 Venue?               @relation(fields: [venueId], references: [id])
  scheduledAt           DateTime?
  scheduleLocked        Boolean              @default(false)
  scheduleOverride      Boolean              @default(false)
  // 临时改期：管理员确认本场可以排在组别比赛日期以外的日子（TournamentGroup.playDates）。
  dateOverride          Boolean              @default(false)
  unscheduledReason     String?              @db.VarChar(255)
  durationMinutes       Int                  @default(45)
  status                MatchStatus          @default(PENDING)
  lineupLocked          Boolean              @default(false)
  startedAt             DateTime?
  finishedAt            DateTime?
  winnerSide            Int?
  forfeitedSide         Int?
  forfeitReason         String?              @db.VarChar(191)
  games                 Game[]
  events                MatchEvent[]
  broadcasts            BroadcastSession[]
  scoreSheets           MatchScoreSheet[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([eventId, roundNo, matchNo])
  @@index([teamMatchId, teamCompetitionItemId])
  @@index([refereeId])
  @@index([venueId, scheduledAt])
  @@index([scheduledAt])
}

enum ScoreSheetStatus {
  VALID
  VOID
}

/// 电子比分单：赛事开启「比赛结束需签字」后，裁判端每结束一场比赛就生成一份。
/// snapshot 冻结签字那一刻的比分（每局比分、逐分过程、双方名单、时间、裁判）；签名图片和渲染好的比分单图片
/// 存在 uploads/match-signatures/<赛事>/<场次>/，表里记文件的相对路径和 SHA-256。contentHash 把比分快照和
/// 两张签名的指纹绑在一起，任何一处被改都对不上。记录不提供修改和删除接口；管理员重开或改分时标为作废并保留。
model MatchScoreSheet {
  id                     String           @id @db.VarChar(32)
  matchId                String
  match                  Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tournamentId           String
  /// NORMAL 正常结束 / FORFEIT 弃权 / RETIRE 伤退退赛 / BLACK_CARD 黑牌取消资格 / BOTH_FORFEIT 双方弃权
  endType                String           @db.VarChar(16)
  winnerSide             Int?
  /// 双打由两人中的一人签字：签字人是胜方第几名选手、叫什么。
  winnerSignerIndex      Int?
  winnerSignerName       String?          @db.VarChar(100)
  winnerSignaturePath    String?          @db.VarChar(255)
  winnerSignatureSha256  String?          @db.Char(64)
  /// 签字的裁判账号（提交结束操作的账号）。
  refereeId              String?
  refereeName            String           @db.VarChar(100)
  refereeSignaturePath   String           @db.VarChar(255)
  refereeSignatureSha256 String           @db.Char(64)
  sheetPath              String?          @db.VarChar(255)
  sheetSha256            String?          @db.Char(64)
  snapshot               Json
  contentHash            String           @db.Char(64)
  /// 比赛结束时间。之后比赛被重置（抽签重排、清空成绩等）时与 Match.finishedAt 对不上，后台显示为已失效。
  matchFinishedAt        DateTime?
  clientIp               String?          @db.VarChar(64)
  userAgent              String?          @db.VarChar(255)
  signedAt               DateTime         @default(now())
  status                 ScoreSheetStatus @default(VALID)
  voidedAt               DateTime?
  voidReason             String?          @db.VarChar(191)
  voidedById             String?

  @@index([matchId, signedAt])
  @@index([tournamentId, signedAt])
}

model Venue {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  matches      Match[]
  allowedGroups GroupVenue[]
  allowedEvents EventVenue[]
  broadcasts   BroadcastSession[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tournamentId, name])
  @@index([tournamentId, isActive, sortOrder])
}

model GroupVenue {
  groupId String
  venueId String
  group TournamentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  @@id([groupId, venueId])
  @@index([venueId])
}

// 单项（男子单打等）指定场地。仅 venueRule = SPECIFIED 时生效。
model EventVenue {
  eventId String
  venueId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  @@id([eventId, venueId])
  @@index([venueId])
}

model ScheduleOperationLog {
  id String @id @default(cuid())
  tournamentId String
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  actorId String?
  action String @db.VarChar(32)
  before Json
  after Json
  createdAt DateTime @default(now())
  @@index([tournamentId, createdAt])
}

model Game {
  id          String    @id @default(cuid())
  matchId     String
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameNo      Int
  side1Score  Int       @default(0)
  side2Score  Int       @default(0)
  server      Int?
  winnerSide  Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([matchId, gameNo])
  @@index([matchId])
}

model MatchEvent {
  id         String         @id @default(cuid())
  matchId    String
  match      Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type       MatchEventType
  side       Int?
  gameNo     Int?
  side1Score Int?
  side2Score Int?
  note       String?
  undoneAt   DateTime?
  createdAt  DateTime       @default(now())

  @@index([matchId, createdAt])
  @@index([type])
}

model DrawBracket {
  id              String             @id @default(cuid())
  eventItemId     String             @map("event_item_id")
  event           Event              @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  version         Int
  isCurrent       Boolean            @default(true) @map("is_current")
  format          DrawFormat
  status          DrawStatus         @default(DRAFT)
  bracketSize     Int                @map("bracket_size")
  entrantCount    Int                @map("entrant_count")
  seedLimit       Int                @map("seed_limit")
  seedCount       Int                @map("seed_count")
  byeCount        Int                @map("bye_count")
  groupCount      Int?               @map("group_count")
  qualifyPerGroup Int?               @map("qualify_per_group")
  executedAt      DateTime?          @map("executed_at")
  frozenAt        DateTime?          @map("frozen_at")
  createdBy       String             @map("created_by")
  updatedBy       String?            @map("updated_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  slots           DrawSlot[]
  operationLogs   DrawOperationLog[]
  groups          DrawGroup[]

  @@unique([eventItemId, version])
  @@index([eventItemId])
  @@index([eventItemId, isCurrent])
  @@index([status])
  @@map("draw_bracket")
}

model DrawSlot {
  id                  String             @id @default(cuid())
  drawBracketId       String             @map("draw_bracket_id")
  drawBracket         DrawBracket        @relation(fields: [drawBracketId], references: [id], onDelete: Cascade)
  position            Int
  entrantId           String?            @map("entrant_id")
  entrant             Registration?      @relation(fields: [entrantId], references: [id], onDelete: SetNull)
  entrantNameSnapshot String?            @db.VarChar(128) @map("entrant_name_snapshot")
  seedNoSnapshot      Int?               @map("seed_no_snapshot")
  isSeed              Boolean            @default(false) @map("is_seed")
  isBye               Boolean            @default(false) @map("is_bye")
  sourceType          DrawSlotSourceType @map("source_type")
  groupRankCode       String?            @db.VarChar(16) @map("group_rank_code")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@unique([drawBracketId, position])
  @@index([drawBracketId])
  @@index([entrantId])
  @@map("draw_slot")
}

model DrawOperationLog {
  id                   String            @id @default(cuid())
  eventItemId          String            @map("event_item_id")
  event                Event             @relation("drawOperationLogEvent", fields: [eventItemId], references: [id], onDelete: Cascade)
  drawBracketId        String            @map("draw_bracket_id")
  drawBracket          DrawBracket       @relation(fields: [drawBracketId], references: [id], onDelete: Cascade)
  operationType        DrawOperationType @map("operation_type")
  operatorId           String            @map("operator_id")
  operator             User              @relation("drawOperationLogOperator", fields: [operatorId], references: [id], onDelete: Cascade)
  operatorNameSnapshot String?           @db.VarChar(64) @map("operator_name_snapshot")
  positionA            Int?              @map("position_a")
  positionB            Int?              @map("position_b")
  beforeData           Json?             @map("before_data")
  afterData            Json?             @map("after_data")
  remark               String?           @db.VarChar(255)
  createdAt            DateTime          @default(now()) @map("created_at")

  @@index([eventItemId, createdAt])
  @@index([drawBracketId, createdAt])
  @@index([operatorId])
  @@index([operationType])
  @@map("draw_operation_log")
}

model DrawSeedSetting {
  id          String       @id @default(cuid())
  eventItemId String       @map("event_item_id")
  event       Event        @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  entrantId   String       @map("entrant_id")
  entrant     Registration @relation(fields: [entrantId], references: [id], onDelete: Cascade)
  seedNo      Int          @map("seed_no")
  createdBy   String       @map("created_by")
  creator     User         @relation("drawSeedSettingCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@unique([eventItemId, seedNo])
  @@unique([eventItemId, entrantId])
  @@index([eventItemId])
  @@map("draw_seed_setting")
}

model DrawGroup {
  id            String            @id @default(cuid())
  drawBracketId String            @map("draw_bracket_id")
  drawBracket   DrawBracket       @relation(fields: [drawBracketId], references: [id], onDelete: Cascade)
  groupCode     String            @db.VarChar(8) @map("group_code")
  sortOrder     Int               @map("sort_order")
  createdAt     DateTime          @default(now()) @map("created_at")
  members       DrawGroupMember[]

  @@unique([drawBracketId, groupCode])
  @@index([drawBracketId])
  @@map("draw_group")
}

model DrawRedrawRequest {
  id              String                  @id @default(cuid())
  eventItemId     String                  @map("event_item_id")
  event           Event                   @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  drawBracketId   String?                 @map("draw_bracket_id")
  status          DrawRedrawRequestStatus @default(PENDING)
  reason          String?                 @db.VarChar(500)
  requesterId     String                  @map("requester_id")
  requester       User                    @relation("drawRedrawRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterNameSnapshot String?           @db.VarChar(64) @map("requester_name_snapshot")
  decidedById     String?                 @map("decided_by_id")
  decidedBy       User?                   @relation("drawRedrawRequestDecider", fields: [decidedById], references: [id], onDelete: Cascade)
  decidedByNameSnapshot String?           @db.VarChar(64) @map("decided_by_name_snapshot")
  decisionRemark  String?                 @db.VarChar(500) @map("decision_remark")
  decidedAt       DateTime?               @map("decided_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@index([eventItemId, status])
  @@index([requesterId])
  @@index([status, createdAt])
  @@map("draw_redraw_request")
}

model TeamDrawClearRequest {
  id                    String                     @id @default(cuid())
  teamCompetitionId     String
  teamCompetition       TeamCompetition            @relation(fields: [teamCompetitionId], references: [id], onDelete: Cascade)
  status                TeamDrawClearRequestStatus @default(PENDING)
  reason                String?                    @db.VarChar(500)
  requesterId           String
  requester             User                       @relation("teamDrawClearRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterNameSnapshot String?                    @db.VarChar(64)
  decidedById           String?
  decidedBy             User?                      @relation("teamDrawClearRequestDecider", fields: [decidedById], references: [id], onDelete: Cascade)
  decidedByNameSnapshot String?                    @db.VarChar(64)
  decisionRemark        String?                    @db.VarChar(500)
  decidedAt             DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@index([teamCompetitionId, status])
  @@index([status, createdAt])
}

model AiConfig {
  id             String   @id @default("default") @db.VarChar(191)
  provider       String   @default("openai") @db.VarChar(64)
  modelName      String   @default("gpt-4o-mini") @db.VarChar(128) @map("model_name")
  apiKey         String   @default("") @db.VarChar(512) @map("api_key")
  apiBase        String   @default("https://api.openai.com/v1") @db.VarChar(512) @map("api_base")
  systemPrompt   String   @db.Text @map("system_prompt")
  maxTokens      Int      @default(2048) @map("max_tokens")
  temperature    Float    @default(0.7)
  enabled        Boolean  @default(true)
  welcomeMessage String   @db.VarChar(500) @map("welcome_message")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("ai_config")
}

model ImageModerationConfig {
  id        String   @id @default("default") @db.VarChar(191)
  enabled   Boolean  @default(false)
  apiKey    String   @default("") @db.VarChar(512) @map("api_key")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("image_moderation_config")
}

model UsageMetric {
  key       String   @id @map("metric_key") @db.VarChar(64)
  count     Int      @default(0) @map("usage_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("usage_metrics")
}

// 全服维护：单行配置（id 固定为 default）。开启后除管理员、超级管理员外，
// 前台所有页面都显示维护页；后端只有超级管理员能做写操作。
model SystemMaintenance {
  id            String    @id @default("default") @db.VarChar(32)
  enabled       Boolean   @default(false)
  title         String    @default("系统维护中") @db.VarChar(80)
  content       String    @db.MediumText
  startedAt     DateTime? @map("started_at")
  expectedEndAt DateTime? @map("expected_end_at")
  updatedBy     String?   @db.VarChar(191) @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("system_maintenance")
}

// 赛事统计的学校名称归并：报名时学校是手填的，同一所学校会有多种写法。超级管理员把
// 写法归到标准校名（canonical），或标记为无效（ignored，不计入高校数）。全局生效。
// alias 存规范化后的写法（去空白、全角转半角、去掉「(xx校区)」）。
model SchoolAlias {
  id        String   @id @default(cuid())
  alias     String   @unique @db.VarChar(191)
  canonical String?  @db.VarChar(191)
  ignored   Boolean  @default(false)
  updatedBy String?  @db.VarChar(191) @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("school_aliases")
}

model DrawGroupMember {
  id                  String       @id @default(cuid())
  drawGroupId         String       @map("draw_group_id")
  drawGroup           DrawGroup    @relation(fields: [drawGroupId], references: [id], onDelete: Cascade)
  entrantId           String       @map("entrant_id")
  entrant             Registration @relation(fields: [entrantId], references: [id], onDelete: Cascade)
  entrantNameSnapshot String?      @db.VarChar(128) @map("entrant_name_snapshot")
  seedNoSnapshot      Int?         @map("seed_no_snapshot")
  groupRank           Int?         @map("group_rank")
  isQualified         Boolean      @default(false) @map("is_qualified")
  createdAt           DateTime     @default(now()) @map("created_at")

  @@unique([drawGroupId, entrantId])
  @@index([drawGroupId])
  @@index([entrantId])
  @@map("draw_group_member")
}
