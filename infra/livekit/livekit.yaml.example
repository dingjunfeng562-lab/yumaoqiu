# Copy to livekit.yaml. Replace domain/certificate paths before public deployment.
port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: true
turn:
  enabled: true
  domain: turn.ydysyumao.cn
  tls_port: 5349
  udp_port: 3478
  external_tls: false
  cert_file: /certs/fullchain.pem
  key_file: /certs/privkey.pem
room:
  auto_create: true
  empty_timeout: 300
  max_participants: 18
logging:
  level: info
