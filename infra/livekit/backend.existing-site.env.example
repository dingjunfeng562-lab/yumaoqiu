# For the existing HTTPS website: no new media subdomain required.
# LiveKit 默认关闭，必须显式设为 true 才会连接媒体服务
LIVEKIT_ENABLED=true
LIVEKIT_URL=wss://ydysyumao.cn/livekit
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=replace-with-generated-key
LIVEKIT_API_SECRET=replace-with-long-random-secret
LIVEKIT_VIEWER_LIMIT=8
CAMERA_PUBLIC_URL=https://ydysyumao.cn
